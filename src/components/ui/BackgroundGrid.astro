---
---

<div class="fixed inset-0 -z-10 pointer-events-none bg-blueprint"></div>
<div id="bg-spotlight" class="fixed inset-0 -z-10 pointer-events-none bg-spotlight"></div>

<script>
  const spotlight = document.getElementById('bg-spotlight');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (spotlight && !reduceMotion && window.matchMedia('(hover: hover)').matches) {
    let raf = 0;
    let x = window.innerWidth / 2;
    let y = window.innerHeight * 0.2;

    window.addEventListener('mousemove', (e) => {
      x = e.clientX;
      y = e.clientY;
      if (!raf) {
        raf = requestAnimationFrame(() => {
          spotlight.style.setProperty('--spot-x', `${x}px`);
          spotlight.style.setProperty('--spot-y', `${y}px`);
          raf = 0;
        });
      }
    }, { passive: true });
  }
</script>

<div id="cursor-dot" class="cursor-dot hidden"></div>

<script>
  import { gsap } from 'gsap';

  const dot = document.getElementById('cursor-dot');
  const canHover = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

  if (dot && canHover && !reduceMotion) {
    document.documentElement.classList.add('has-custom-cursor');
    dot.classList.remove('hidden');

    const moveX = gsap.quickTo(dot, 'x', { duration: 0.35, ease: 'power3.out' });
    const moveY = gsap.quickTo(dot, 'y', { duration: 0.35, ease: 'power3.out' });

    window.addEventListener('mousemove', (e) => {
      moveX(e.clientX);
      moveY(e.clientY);
    }, { passive: true });

    const interactiveSelector = 'a, button, input, textarea, .magnetic-wrap';
    document.addEventListener('mouseover', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest(interactiveSelector)) {
        dot.classList.add('is-hovering');
      }
    });
    document.addEventListener('mouseout', (e) => {
      const target = e.target as HTMLElement;
      if (target.closest(interactiveSelector)) {
        dot.classList.remove('is-hovering');
      }
    });
  }
</script>
